{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kleiner Hofladen",
  "mainBinaryName": "Kleiner-Hofladen",
  "version": "15.0.1",
  "identifier": "de.kleinerhofladen.spiel",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Kleiner Hofladen",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
