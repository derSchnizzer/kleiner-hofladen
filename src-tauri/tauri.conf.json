    "publisher": "jarpety",
    "copyright": "© 2026 Kleiner Hofladen",
    "category": "SimulationGame",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["German"],
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGRTZBNkIyQjlENTVEMDkKUldRSlhkVzVzcWJtbjlEbUljQ1BOUllqL1lQOWZJanF0M2ZQTUN6VWk4bk1HMDExZDhtOGpiOHYK",
      "endpoints": [
        "https://github.com/derSchnizzer/kleiner-hofladen/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
